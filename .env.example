# OpenAI 兼容文本模型服务的完整基础 URL，按服务商要求填写路径前缀（示例包含 /v1）。
AI_BASE_URL=https://your-openai-compatible-host/v1

# 文本模型的 API 密钥，仅从配置中心数据库或 .env.local 读取，数据库优先。
AI_API_KEY=

# 用于文章生成的文本模型名称。
AI_TEXT_MODEL=

# 图片生成接口的完整 URL。
AI_IMAGE_URL=https://your-openai-compatible-host/v1/images/generations

# 图片模型的独立 API 密钥，仅从配置中心数据库或 .env.local 读取，数据库优先。
# 留空时不使用文本模型密钥或 OPENAI_API_KEY。
AI_IMAGE_API_KEY=

# 用于配图生成的图片模型名称。
AI_IMAGE_MODEL=

# Firecrawl API 密钥，用于资料搜索。
FIRECRAWL_API_KEY=

# 知乎数据开放平台的 Access Secret。
ZHIHU_ACCESS_SECRET=

# 微信公众号 AppID。
WECHAT_APPID=

# 微信公众号 AppSecret。
WECHAT_SECRET=

# 微信公众号文章作者名称。
WECHAT_AUTHOR=

# 是否启用微信公众号自动发布：true 自动发布，false 仅创建草稿（默认）。
# 自动发布仅允许企业主体已认证账号调用。
WECHAT_AUTO_PUBLISH=false
